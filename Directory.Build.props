<Project>
  <!-- The version is set here for all projects. Add a Changelog entry in README.md when bumping it. -->
  <PropertyGroup>
    <Version>1.13.0</Version>
    <Company>Västra Götalandsregionen</Company>
    <Product>DCST4</Product>
    <!-- The year is the year of the build, so a new release never shows an old year. -->
    <Copyright>Copyright © Anders Dahlgren $([System.DateTime]::Now.Year)</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
