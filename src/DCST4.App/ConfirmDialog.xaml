<Window x:Class="DCST4.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel Margin="16,16,16,12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="YesButton" Content="Yes" Width="80" Height="25" Margin="0,0,10,0" IsDefault="True" Click="YesButton_Click"/>
            <Button Content="No" Width="80" Height="25" IsCancel="True"/>
        </StackPanel>
        <Image x:Name="QuestionIcon" DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0"/>
        <!-- One line per line of the message, however long: the window grows to fit, and scrolls only past the screen. -->
        <ScrollViewer x:Name="MessageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="NoWrap"/>
        </ScrollViewer>
    </DockPanel>
</Window>
