<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DCST4</RootNamespace>
    <AssemblyName>DCST4</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>DCST4.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AssemblyTitle>DCST4</AssemblyTitle>
    <Description>DICOM C-Store Tester 4</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DCST4.Core\DCST4.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DCST4.ico" />
    <Resource Include="VGR.png" />
  </ItemGroup>

  <!-- Same layout as DMWLT4: the exe and its config at the top, all libraries in libs\ (see the probing path in App.config). -->
  <Target Name="MoveDllsToLibs" AfterTargets="Build">
    <ItemGroup>
      <DllsToMove Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)libs" />
    <Move SourceFiles="@(DllsToMove)" DestinationFolder="$(TargetDir)libs" />
  </Target>
  <Target Name="DeleteLibDirectoryOnClean" AfterTargets="Clean">
    <RemoveDir Directories="$(TargetDir)libs" />
  </Target>

</Project>
