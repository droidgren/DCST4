<Window x:Class="DCST4.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650"
        Width="900"
        MinHeight="300"
        MinWidth="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="H1" TargetType="Paragraph">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
            <Setter Property="Foreground" Value="#FF1F3A5F"/>
        </Style>
        <Style x:Key="H2" TargetType="Paragraph">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="Paragraph">
            <Setter Property="Background" Value="#FFF3F6FA"/>
            <Setter Property="BorderBrush" Value="#FFB8C7DA"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="List">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
        </Style>
        <Style TargetType="Table">
            <Setter Property="CellSpacing" Value="0"/>
            <Setter Property="BorderBrush" Value="#FFD0D7E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style TargetType="TableCell">
            <Setter Property="BorderBrush" Value="#FFD0D7E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TopicList" Grid.Column="0" BorderThickness="0" Background="#FFF5F7FA" Padding="0,8"
                 SelectionChanged="TopicList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#FFE1E6EC"/>

        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Column="2" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <FlowDocument x:Name="HelpDocument" FontFamily="Segoe UI" FontSize="13" PagePadding="24,8,24,24"
                          TextAlignment="Left" LineHeight="20">

                <!-- ===================================================================== -->
                <Section Tag="Getting started">
                    <Paragraph Style="{StaticResource H1}">Getting started</Paragraph>
                    <Paragraph>
                        DICOM C-Store Tester generates test images and sends them to a PACS or other DICOM storage
                        server with C-STORE. It can also save them to disk, and test what a PACS supports.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">A first exam in four steps</Paragraph>
                    <List MarkerStyle="Decimal">
                        <ListItem><Paragraph>Under <Bold>Server</Bold>, enter the server's <Bold>AET</Bold>, <Bold>IP/Hostname</Bold> and <Bold>Port</Bold>. Try <Bold>Ping</Bold> and <Bold>Dicom Echo</Bold>.</Paragraph></ListItem>
                        <ListItem><Paragraph>Under <Bold>Exam</Bold>, select the modality (CT, MR, CR, DX, US, XA, RF, MG, PT or NM, or a multi-frame image) and exam type, and how many images you want. 1 series with 1 image gives a single test image. <Bold>Estimated size</Bold> shows how much data that is.</Paragraph></ListItem>
                        <ListItem><Paragraph>Click <Bold>Generate &amp; Send</Bold>, and follow each image in the <Bold>Results</Bold> tab.</Paragraph></ListItem>
                        <ListItem><Paragraph>Look the exam up in the PACS viewer. To compare the image with the tags, turn on burned-in text under <Bold>File &gt; Settings</Bold> first.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">
                        Assume that images cannot be deleted from a PACS once they are stored. Check the destination,
                        and keep the number of images small.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Connection">
                    <Paragraph Style="{StaticResource H1}">Connection</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="140"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Calling AET</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The AE title of this program. Many servers only accept AE titles they have been configured for.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>AET</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The called AE title of the server.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>IP/Hostname</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Address of the server.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Port</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>DICOM port of the server.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Use TLS</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Encrypt the connection. See <Italic>TLS</Italic> below.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Testing the connection</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Ping</Bold> checks that the host answers on the network (ICMP). Some networks block ping, so a failed ping does not have to mean that DICOM fails.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Dicom Echo</Bold> sends a C-ECHO. It succeeds only if the server accepts the association and answers with status Success. The time is shown.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H2}">Profiles</Paragraph>
                    <Paragraph>A profile stores the Calling AET, the server's AET, host and port and the TLS options under a name.</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Save:</Bold> type a name in the <Bold>Profile</Bold> box and click <Bold>Save</Bold>. A profile with that name is updated.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Use:</Bold> pick a profile in the list. Its values are copied into the fields.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Delete:</Bold> pick or type the name and click <Bold>Delete</Bold>. You are asked to confirm.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">
                        Changing a field after picking a profile does not change the profile. Click <Bold>Save</Bold> again to store the change.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">TLS</Paragraph>
                    <Paragraph>Tick <Bold>Use TLS</Bold> to connect with TLS. The server must listen for TLS on the given port. <Bold>TLS options...</Bold> has these settings:</Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Accept self-signed or invalid server certificates.</Bold> Use only for testing, because the server's identity is then not verified.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Client certificate.</Bold> For a server that requires one. <Bold>Select...</Bold> picks a certificate with a private key from your personal certificate store, and <Bold>Clear</Bold> removes it.</Paragraph></ListItem>
                    </List>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Creating an exam">
                    <Paragraph Style="{StaticResource H1}">Creating an exam</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="170"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Modality</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>CT, MR, CR, DX, US, XA, RF, MG, PT or NM, and last the multi-frame images US Multi-frame, Enhanced CT, Enhanced MR and Breast Tomosynthesis. Choosing one sets its usual matrix, bit depth, frames and exam type.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Exam type</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Sets the descriptions, body part, modality-specific tags and usual number of images.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Series</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Number of series. A run can have at most 100,000 images in total.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Images per series</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Number of images in each series. The total is shown next to the field. For a multi-frame modality it is the number of multi-frame objects, and starts at 1.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Rows x Columns</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The matrix, 64 to 4096.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Bits stored</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The list shows what the selected modality's IOD allows.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Character set</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Specific Character Set. See <Italic>Character sets</Italic>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Transfer syntax</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Implicit VR, Explicit VR, JPEG Lossless or, for 8 bits stored, JPEG Baseline, which is lossy. See <Italic>Transfer syntax and fallback</Italic>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Estimated size</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>How much data the whole exam will be. It updates as you change the other fields.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Frames per image</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>For a multi-frame modality: how many frames each image has, 1 to 10,000. 30 for a cine loop and 8 for the others when the modality is selected.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Add private payload</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Adds a large private binary value of the given size to every image. Off at every start. See below.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Estimated size</Paragraph>
                    <List>
                        <ListItem><Paragraph>Implicit and Explicit VR: calculated from the matrix, bit depth and number of images.</Paragraph></ListItem>
                        <ListItem><Paragraph>JPEG Lossless and JPEG Baseline: one sample image is compressed in the background and the result is multiplied by the number of images, since the size depends on the picture. <Italic>calculating...</Italic> is shown meanwhile. The test images compress far better than real ones.</Paragraph></ListItem>
                        <ListItem><Paragraph><Italic>at most</Italic> means that no sample could be made, so the uncompressed size is shown as the upper limit.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>-</Bold> means that a value is outside its allowed range.</Paragraph></ListItem>
                    </List>
                    <Paragraph>The DICOMDIR of a saved File-set is not counted. For a compressed multi-frame image the sample has a few frames, and the rest are taken to be as large. A private payload is added as it is.</Paragraph>
                    <Paragraph Style="{StaticResource H2}">Multi-frame images</Paragraph>
                    <Paragraph>
                        <Bold>US Multi-frame</Bold> is a colour cine loop of 30 frames per second, as an ultrasound system
                        sends. <Bold>Enhanced CT</Bold>, <Bold>Enhanced MR</Bold> and <Bold>Breast Tomosynthesis</Bold> are
                        the multi-frame objects with functional groups for each frame. The frames are drawn as they are
                        written and are never all in memory, so an object can be larger than the computer's memory.
                    </Paragraph>
                    <List>
                        <ListItem><Paragraph>With JPEG Lossless or JPEG Baseline the frames are encoded before the image is sent, a few at a time. The status bar counts them, and <Bold>Cancel</Bold> works meanwhile. JPEG Baseline is the slow one: a cine loop of 1,667 frames of 960 x 1280 takes a few minutes.</Paragraph></ListItem>
                        <ListItem><Paragraph>Without compression the pixels of one image must be less than 4 GB, which is what a DICOM element can hold. A long cine loop needs JPEG Baseline or JPEG Lossless, and the run stops with a message otherwise.</Paragraph></ListItem>
                        <ListItem><Paragraph>JPEG Baseline holds 8 bits, so it can be chosen for US, US Multi-frame, and CR, DX, XA, RF and NM at 8 bits stored. The image is marked as lossy and as DERIVED, and a colour image is stored as YBR_FULL_422.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource H2}">Private payload</Paragraph>
                    <Paragraph>
                        Some ultrasound systems send their raw data along with a cine loop, as one private value that can be
                        several times the size of the pixels. <Bold>Add private payload of ... MB per image</Bold> does the
                        same, to find out whether a PACS takes images with large private data and keeps it: a private
                        sequence, (0099,1020) under the private creator DCST4 TEST, with one binary value of 1 to 2,000 MB.
                        The value is random bytes, so it does not compress away, and it is written as it is generated,
                        without being held in memory.
                    </Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        The box is unticked every time DCST4 starts, so that a large payload is never sent because it was on
                        the last time. The size is remembered. Assume that a PACS cannot delete what it receives, and try a
                        large object against a test system first.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Running</Paragraph>
                    <List>
                        <ListItem><Paragraph>Under <Bold>Output</Bold>, tick <Bold>Send to server</Bold>, <Bold>Save to disk</Bold> or both.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Generate &amp; Send</Bold> starts the run. It reads Generate &amp; Save when only saving.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Cancel</Bold> stops the run.</Paragraph></ListItem>
                    </List>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Identifiers and Auto values">
                    <Paragraph Style="{StaticResource H1}">Identifiers and Auto values</Paragraph>
                    <Paragraph>
                        Everything on the <Bold>Identifiers</Bold> tab is generated by default, and the fields show what
                        the next run will use. Untick <Bold>Auto</Bold> to enter your own value. Auto values are drawn
                        when the program starts and when you click <Bold>New values</Bold>, and they stay on screen after
                        a run so you can look the exam up in PACS. The values a run used are also written to the
                        <Bold>Log</Bold> tab. The Auto patient name is DCST4^TEST^number by default, which is plainly not
                        a person, or an invented Swedish name if you choose that on the <Bold>Identifiers</Bold> tab under
                        <Bold>File &gt; Settings</Bold>.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Running again</Paragraph>
                    <Paragraph>
                        Running again without <Bold>New values</Bold> uses the same patient, accession number and Study
                        UID, so the images arrive as a new series in the same study, also if you changed modality or exam
                        type. Series numbers start at 1 again, and an Auto Study Date/Time is the time of each run. Click
                        <Bold>New values</Bold> to start a separate study. To draw new values after every run instead, tick
                        <Bold>Draw new Auto values after each run</Bold> under <Bold>File &gt; Settings</Bold>.
                    </Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        A manual Series UID requires exactly one series, and a manual SOP Instance UID exactly one image,
                        because these must be unique.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Patient IDs</Paragraph>
                    <Paragraph>
                        Random Patient IDs only ever come from Skatteverket's official list of test personnummer, built
                        into the program. Birth date and sex are taken from the number. The list also holds future dates
                        and people born in the 1890s, so random selection is limited to the age range below the fields,
                        0 to 100 by default.
                    </Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        If you enter a Patient ID that is not on the list, the program warns you. It is still used, but
                        make sure it is not a real person's number.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Additional tags">
                    <Paragraph Style="{StaticResource H1}">Additional tags</Paragraph>
                    <Paragraph>
                        Under <Bold>File &gt; Settings</Bold>, on the <Bold>Additional tags</Bold> tab, you can add tags on
                        top of the fixed fields. Each one gets a row on the <Bold>Identifiers</Bold> tab, where you can
                        untick <Bold>Auto</Bold> and type a value for the session.
                    </Paragraph>
                    <List>
                        <ListItem><Paragraph><Bold>Common tags</Bold> are ticked in a list, and Auto generates their values.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Custom tags</Bold> are entered as (0008,1070), 00081070 or a keyword such as OperatorsName, and Auto uses the default value you enter. An empty default sends the tag empty. Separate several values with a backslash where the tag allows it.</Paragraph></ListItem>
                        <ListItem><Paragraph><Bold>Private tags</Bold>, those with an odd group number, also need a private creator and a VR.</Paragraph></ListItem>
                    </List>
                    <Paragraph>
                        A custom tag can replace a generated value such as Manufacturer, but not one that would break the
                        image or remove its marking as a test image. The message says why when a tag cannot be added.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Character sets">
                    <Paragraph Style="{StaticResource H1}">Character sets</Paragraph>
                    <Paragraph>About 40% of random names contain å, ä or ö. Select the <Bold>Character set</Bold> under <Bold>Exam</Bold>:</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="140"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>ISO_IR 100</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Latin-1.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>ISO_IR 192</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>UTF-8.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Empty value</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Sends the tag with zero length, which means Basic ASCII (ISO 646). Random names then lose their å, ä and ö, so Åström becomes Astrom. A strict validator may object to the empty tag, since Specific Character Set should have a value when it is present.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph>A manual value that the selected set cannot represent stops the run with a message, rather than being sent wrong.</Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        If the viewer shows Ã¥ instead of å, the system has read UTF-8 text as Latin-1. With burned-in text
                        turned on, the text in the image shows what was intended.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Burned-in text">
                    <Paragraph Style="{StaticResource H1}">Burned-in text</Paragraph>
                    <Paragraph>
                        By default the images have no burned-in patient details. Under <Bold>File &gt; Settings</Bold>, on
                        the <Bold>Burned-in text</Bold> tab, you can turn on a black text box in the upper left corner of
                        each image and tick which tags it shows. The values are read from the image's own tags.
                    </Paragraph>
                    <Paragraph>
                        Burned In Annotation is YES when text is drawn, otherwise NO. The diagonal TEST IMAGE watermark is
                        always there.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Transfer syntax and fallback">
                    <Paragraph Style="{StaticResource H1}">Transfer syntax and fallback</Paragraph>
                    <Paragraph>
                        The images are sent in the selected transfer syntax. fo-dicom also always proposes Implicit VR in
                        a presentation context of its own, as DICOM expects. Each context is shown in the
                        <Bold>Log</Bold> tab with the server's answer.
                    </Paragraph>
                    <Paragraph>
                        If the server does not accept the selected syntax, the run stops with an error and nothing is
                        sent, so a test of JPEG Lossless can not pass by accident. A transfer syntax that the
                        images cannot be written in, such as JPEG Baseline for 16 bits, stops the run before anything is sent.
                    </Paragraph>
                    <Paragraph>
                        Tick <Bold>Allow fallback to Implicit VR</Bold> to send as Implicit VR instead, as a real modality
                        would. The run then finishes with a warning, and the <Bold>Syntax used</Bold> column shows what
                        was really sent.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Saving to disk">
                    <Paragraph Style="{StaticResource H1}">Saving to disk</Paragraph>
                    <Paragraph>
                        Tick <Bold>Save to disk</Bold>, with or without <Bold>Send to server</Bold>. The folder becomes a
                        DICOM File-set that viewers can open: a DICOMDIR at the top, and the images in
                        DICOM\EX000001\S001\IM0001 in the selected transfer syntax. DICOM limits these names to 8
                        characters and no extension, so the folders do not show patient details. The
                        <Bold>Saved to</Bold> column shows where each image went.
                    </Paragraph>
                    <List>
                        <ListItem><Paragraph>Each run gets a new EX folder and nothing is overwritten.</Paragraph></ListItem>
                        <ListItem><Paragraph>Saving again to the same folder adds to the same DICOMDIR.</Paragraph></ListItem>
                        <ListItem><Paragraph>Each file is saved before it is sent, so it exists even if sending fails.</Paragraph></ListItem>
                        <ListItem><Paragraph>The DICOMDIR is written when the run ends, also if it stopped early.</Paragraph></ListItem>
                    </List>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Reading the results">
                    <Paragraph Style="{StaticResource H1}">Reading the results</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="110"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Success</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Status 0x0000. The server has taken responsibility for the image.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFFFF4C2"><TableCell><Paragraph><Bold>Warning</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Stored, but the server changed or dropped something. For example 0xB000 coercion, 0xB006 elements discarded, 0xB007 data set does not match the SOP class.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFFAD4D0"><TableCell><Paragraph><Bold>Failure</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Not stored. For example 0xA7xx out of resources, 0xA9xx data set does not match, 0xCxxx cannot understand. The run continues with the next image.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFE6E6E6"><TableCell><Paragraph><Bold>NotSent</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>No response for this image, for example because the association was rejected, aborted or timed out. The description says why.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph>
                        Vendor-specific codes keep their real value in the <Bold>Status</Bold> column. The status bar shows
                        the totals and throughput of the last run. Images never generated because the run stopped early
                        have no row, but are counted as not sent in the totals.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Running tests">
                    <Paragraph Style="{StaticResource H1}">Running tests against a PACS</Paragraph>
                    <Paragraph>
                        On the <Bold>Tests</Bold> tab below the exam settings, tick the tests and click <Bold>Run tests</Bold>.
                        They run against the destination entered under <Bold>Server</Bold>. Select a row to see its
                        explanation and the steps of the association, with the raw status of each response.
                        <Bold>Cancel</Bold> stops the run, and what was finished is still saved. While a run is going,
                        the status bar shows which test is running, what it is doing or waiting for, and for how many
                        seconds. The load tests are on the <Bold>Performance</Bold> tab, see the topic Performance.
                    </Paragraph>
                    <Paragraph>
                        The tests are grouped: Association, Store, Query, Retrieve &amp; integrity, Storage Commitment,
                        Duplicates, TLS, Limits and Faults. The groups start folded: click the arrow of a group to open it,
                        and its box to tick or clear all its tests. <Bold>Check all</Bold> above the list does the same for every test, and the
                        count beside it says how many are ticked. Nothing is ticked when the program starts. Hover over a
                        test to see what it does, what it needs, what it stores and its id for the command line.
                    </Paragraph>
                    <Paragraph>
                        Beside the buttons are the <Bold>Local SCP AET</Bold> and <Bold>Port</Bold> that C-MOVE and Storage
                        Commitment reports go to. The other settings of the tests are in <Bold>Test settings...</Bold>: the UID
                        root, the transfer syntax of the store tests, the Storage Commitment times, the settings of the limit,
                        fault and TLS tests. They change only when you click <Bold>OK</Bold>, and a
                        value that cannot be used is named and nothing is changed. Hover over a setting to see what it does and its default.
                        <Bold>Open results folder</Bold> opens the folder in Explorer.
                    </Paragraph>
                    <Paragraph>
                        <Bold>A run that stores objects asks first.</Bold> If any ticked test can leave new objects on the
                        destination, DCST4 names the destination and lists those tests, each with how many examinations
                        and objects it stores and about how much data, and then the total. The sizes are uncompressed, the
                        most a test sends. The run starts only when you say yes.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Results</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="150"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>PASS</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The system did what the test expects.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFFAD4D0"><TableCell><Paragraph><Bold>FAIL</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>It answered, refused or broke off in a way the test does not accept.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFFFF4C2"><TableCell><Paragraph><Bold>NOT_SUPPORTED</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>It said it does not support this, for example by not accepting the SOP class.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>EXPECTED_FAILURE</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>It refused something it is supposed to refuse.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFE6E6E6"><TableCell><Paragraph><Bold>TIMEOUT</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>No connection, association or response within the timeout under <Bold>File &gt; Settings</Bold>.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFE6E6E6"><TableCell><Paragraph><Bold>INDETERMINATE</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The test could not reach a verdict, for example because the run was cancelled.</Paragraph></TableCell></TableRow>
                            <TableRow Background="#FFFAD4D0"><TableCell><Paragraph><Bold>TOOL_ERROR</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>A bug or local problem in this program, such as a missing client certificate. Not the fault of the PACS.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Result files</Paragraph>
                    <Paragraph>
                        Each run is saved as a JSON file with full detail and a CSV file with one row per result, in the
                        results folder. A run with store tests also writes the chain as a CSV file. The client certificate
                        thumbprint is never written to them. Every run also writes a report as one HTML file, which
                        <Bold>Open report</Bold> opens, and <Bold>Compare runs...</Bold> compares saved runs. See the topic
                        Reports and comparison.
                    </Paragraph>
                    <Paragraph>
                        The results folder and the files a run writes are under <Bold>File &gt; Settings</Bold>, on the
                        <Bold>Test and Performance Results</Bold> tab, for runs on the Tests and Performance tabs. The boxes
                        after <Bold>Each run writes</Bold> choose JSON, CSV, the HTML report, and the series files of a
                        Performance test. Only the HTML report is ticked from the start. <Bold>Compare runs...</Bold>
                        reads the JSON file, so tick JSON for runs you want to compare later. The series files, one row per
                        second, are written while a Performance test runs, so a crash keeps what was measured. The report
                        made right after a run has its per-second chart either way. With no box ticked a run writes
                        nothing, and the status bar says so.
                    </Paragraph>
                    <Paragraph>
                        <Bold>Delete results older than</Bold> makes DCST4 tidy the results folder. After each run it
                        deletes the result files, reports and comparisons there that are older than the number of days you
                        enter: the files whose names start with <Italic>DCST4-run-</Italic> or
                        <Italic>DCST4-compare-</Italic> and end in <Italic>.json</Italic>, <Italic>.csv</Italic> or
                        <Italic>.html</Italic>. Nothing else in the folder is touched, no subfolder is looked into, and
                        nothing is deleted until a run has been saved. 0, which it is from the start, keeps everything.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="What the PACS supports">
                    <Paragraph Style="{StaticResource H1}">What the PACS supports</Paragraph>
                    <Paragraph>
                        The negotiation probe on the <Bold>Tests</Bold> tab finds out what the destination supports from
                        association negotiation alone. No images are sent. For each SOP class it proposes every transfer
                        syntax in a presentation context of its own, split over several associations since one can hold
                        at most 128 contexts.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">The Capabilities tab</Paragraph>
                    <Paragraph>
                        One row per SOP class and one column per transfer syntax. Rest the mouse on a cell to see the full
                        answer, and on a column heading for the full name. <Bold>Save as JSON</Bold> and
                        <Bold>Save as CSV</Bold> write the table, and every run also saves it next to the result files.
                        The tab also shows what the destination identified itself as and its maximum PDU length.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Comparing with the Conformance Statement</Paragraph>
                    <Paragraph>
                        <Bold>Load claimed</Bold> reads a JSON file of what the vendor's Conformance Statement claims, in
                        the same layout as the saved matrix, and lists what was claimed but rejected, accepted but not
                        claimed, and claimed but never answered.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Tests of refusals</Paragraph>
                    <Paragraph>
                        Three more tests check an unknown calling AE title, a wrong called AE title, and an association
                        with only unsupported contexts. EXPECTED_FAILURE means the destination refused as it should. A
                        destination that accepts an unknown AE title gets FAIL, as a finding to report and not as a fault
                        in this program.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Store, query and retrieve">
                    <Paragraph Style="{StaticResource H1}">Store, query and retrieve</Paragraph>
                    <Paragraph>
                        These tests store small, marked test objects on the destination and check that it can find them,
                        return them and return them unchanged. <Bold>Assume that a PACS cannot delete what it receives.</Bold>
                        DCST4 asks before a run with any of them and names the destination, so check that the destination
                        under <Bold>Server</Bold> is the one you mean. The query, retrieve and Storage Commitment tests work
                        on what the store tests of the same run stored, so tick a store test with them.
                    </Paragraph>
                    <Paragraph>
                        There is a store test for each kind of object, the multi-frame ones included: US Multi-frame,
                        Enhanced CT, Enhanced MR and Breast Tomosynthesis are sent with 8 frames of 128 by 128.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Test settings</Paragraph>
                    <Paragraph>
                        In <Bold>Test settings...</Bold> on the Tests tab, <Bold>UID root</Bold> is what the UIDs of the objects the tests send start with. <Bold>Store tests send
                        in</Bold> chooses the transfer syntax. Its first choice takes it from the capability matrix for each
                        object type, from the negotiation probe in the same run or on the <Bold>Capabilities</Bold> tab, and
                        otherwise uses Explicit VR. A syntax you choose is used wherever the object type allows it.
                    </Paragraph>
                    <Paragraph>
                        <Bold>Run tests</Bold> draws new data each time, so that a second run is not a set of duplicates of
                        the first. The seed it used is written to the result file.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">The Chain tab</Paragraph>
                    <Paragraph>
                        One row per object type. Each step has its own result, and a step that did not run shows a dash:
                        <Bold>Accepted</Bold> by C-STORE, <Bold>Indexed</Bold> so that C-FIND finds it, <Bold>Retrievable</Bold>
                        by C-GET or C-MOVE, and <Bold>Intact</Bold> when compared with what was sent. Select a row for the
                        explanations. <Bold>Committed</Bold> is the answer to Storage Commitment, from the test
                        <Bold>Storage Commitment: every stored instance</Bold>. See the topic Storage Commitment.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Before C-MOVE works</Paragraph>
                    <Paragraph>
                        C-MOVE makes the PACS connect back to this computer. On the <Bold>Tests</Bold> tab, <Bold>Local SCP AET</Bold>
                        and <Bold>Port</Bold> say how. Add that AE title on the PACS with this computer's address and the port,
                        and allow incoming TCP on the port. On Windows, Windows Defender Firewall is a common reason why
                        nothing arrives, and the test <Bold>C-MOVE: can the system reach this computer?</Bold> says what it
                        found. Such a problem gives INDETERMINATE on the C-MOVE test, since it says nothing about the PACS.
                        The test then stops after the first object type and marks the others as not tried, since the cause
                        is the same for all of them.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">What Intact means</Paragraph>
                    <Paragraph>
                        Each retrieved object is compared with the copy that was sent, level by level: <Bold>Transport</Bold>
                        (everything came back), <Bold>Identity</Bold> (the UIDs are unchanged), <Bold>Attributes</Bold> (tag by
                        tag), <Bold>Pixel</Bold> and <Bold>Transfer syntax</Bold>. A change that Original Attributes Sequence
                        records is a documented coercion, and is not a failure. A change that nothing records is a silent
                        modification. Private tags kept or dropped, character set changes and truncated values are reported
                        separately. Pixels are byte-identical, lossless-equivalent (the same pixels in another syntax), lossy
                        changed (with the largest and mean difference) or corrupt.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Duplicates and conflicts</Paragraph>
                    <Paragraph>
                        Three tests send the same SOP Instance UID again, with identical and with changed content, and
                        one study with two different patients. A refusal is EXPECTED_FAILURE. For the changed content the
                        result says which version was kept. Keeping two patients in one study without any change or warning
                        is FAIL, as a finding to report. These tests leave those objects on the destination.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Storage Commitment">
                    <Paragraph Style="{StaticResource H1}">Storage Commitment</Paragraph>
                    <Paragraph>
                        A C-STORE that succeeds says the PACS received an object. Storage Commitment asks it to promise that
                        it keeps it. DCST4 sends an N-ACTION with the objects stored earlier in the same run, and the PACS
                        answers later with an N-EVENT-REPORT, either on the same association or on a new one that it opens
                        to this computer. The tests record which way it used and how long the report took. They send no
                        objects of their own.
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="220"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Every stored instance</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>PASS if all are committed. FAIL if any is not, with its Failure Reason. Fills Committed on the Chain tab.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>An instance that was never stored</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Adds a UID that no test stored. EXPECTED_FAILURE if the PACS refuses that one with a Failure Reason and commits the rest. FAIL, as a finding, if it says it committed it.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Test settings</Paragraph>
                    <Paragraph>
                        In <Bold>Test settings...</Bold> on the Tests tab, <Bold>Keep the association open</Bold> is how many seconds the association of the N-ACTION stays open, so
                        that the report can come on it. The association stays open for that long even if the report comes
                        sooner. 0 releases it at once, as many modalities do, and the report must then come on a new
                        association. <Bold>Wait for the report</Bold> is how long the report may take after the N-ACTION
                        response before the test gives TIMEOUT. <Bold>Then keep listening</Bold> is how much longer DCST4
                        listens after that, so that the explanation can say whether the report came late or not at all.
                    </Paragraph>
                    <Paragraph>
                        A report on a new association goes to <Bold>Local SCP AET</Bold> and <Bold>Port</Bold>, as C-MOVE does.
                        The PACS must know that AE title with this computer's address and port, and Windows Defender Firewall
                        must allow incoming TCP on the port. A report for a transaction DCST4 did not start is refused with
                        0x0110 and counted in the result.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Limits and faults">
                    <Paragraph Style="{StaticResource H1}">Limits and faults</Paragraph>
                    <Paragraph>
                        The tests marked <Italic>Limits</Italic> find the limits of the PACS and show what it does when a
                        transfer goes wrong. They are in the TLS, Limits and Faults groups. They hold associations open on
                        the PACS, break transfers on purpose, leave up to eight more test images on it, and take minutes with
                        the default waits, so tick only the ones you want. They depend on no other test.
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="220"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Simultaneous associations</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Opens associations one at a time and holds them, until one is refused or the number in <Bold>Associations up to</Bold> is reached. EXPECTED_FAILURE when the PACS rejects one, with the limit and the reason it gave. PASS when all were held: the limit is higher. FAIL, as a finding, if it aborts or closes the connection instead of rejecting. All are released afterwards.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Idle association timeout</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Opens an association and sends nothing for <Bold>Idle wait</Bold> seconds. Records how the PACS ended it, or that it was still open. PASS either way. The time is on the timeline.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Connection without an association request (ARTIM)</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Connects and never sends a request, for <Bold>ARTIM wait</Bold> seconds. PASS if the PACS closes the connection. FAIL, as a finding, if it is still open.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Maximum PDU length</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Stores four small CT images, each sent in data PDUs of exactly the length the PACS said it takes, while DCST4 announces four different lengths of its own.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>PDU longer than the announced maximum</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Sends one CT image in PDUs 1024 bytes longer than the PACS said it takes. EXPECTED_FAILURE if it refuses. FAIL, as a finding, if it stores the image.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>The three Fault tests</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Send a CT image of 2 MB and break off: with an A-ABORT halfway, by resetting the connection halfway, or by closing it when everything is sent but before the response is read. Then the test asks whether the image is there, gets it back to see whether it is complete, and sends it again as a modality would.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>The four TLS tests</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Record the TLS version and cipher, check the server certificate strictly against the host name, and present a client certificate from an unknown authority and an expired one, both of which the PACS should refuse. INDETERMINATE when <Bold>Use TLS</Bold> is not ticked.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">After a fault</Paragraph>
                    <Paragraph>
                        PASS when the PACS kept nothing or a complete image and stored the retry. EXPECTED_FAILURE when it
                        refused the retry as a duplicate (0x0111) of an image it holds. FAIL, as a finding, when it kept a
                        partial image, or refused the retry as a duplicate although a query does not find the image. FAIL when
                        the retry is refused with another status. <Bold>After a fault, look for</Bold> is how many seconds the
                        test goes on asking for the image before it counts as not there. Raise it for a PACS that indexes
                        slowly. A fault test whose image is already on the PACS, from an earlier run with the same seed, gives
                        INDETERMINATE and sends nothing.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">The client certificate tests</Paragraph>
                    <Paragraph>
                        The certificate from an unknown authority is made by DCST4 for the test and is never put in a
                        certificate store. An expired certificate must come from an authority the PACS trusts, so DCST4 cannot
                        make one. Install one in your personal certificate store and enter its thumbprint in
                        <Bold>Expired client certificate</Bold> in <Bold>Test settings...</Bold>. Without it that test gives NOT_SUPPORTED. A PACS that does not
                        ask for a client certificate at all also gives NOT_SUPPORTED. The server certificate test reports what
                        this computer sees, so a certificate from an internal authority that is not installed here is reported
                        as not trusted.
                    </Paragraph>
                    <Paragraph>
                        Every test releases or aborts what it opened, also when you click <Bold>Cancel</Bold>.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Performance">
                    <Paragraph Style="{StaticResource H1}">Performance</Paragraph>
                    <Paragraph>
                        The <Bold>Performance</Bold> tab measures throughput and latency against the destination above.
                        <Bold>Every image sent is a new object on the PACS, which may not be possible to delete.</Bold> Before a
                        run starts, DCST4 shows how many objects it will store at most, about how much data that is, and the
                        destination, and starts only when you say yes. The test and the <Bold>Mix</Bold> are chosen on the tab,
                        and everything else in <Bold>Performance settings...</Bold>, where every setting explains itself on hover.
                        <Bold>Max instances</Bold> caps every run. It shows the default of the selected test until you change it: 5000 for Load, 12000 for Ramp and the rate times the duration for Soak. A value you set applies to all three tests, and 0 goes back to the defaults. A fast PACS can
                        reach it before the duration is over. The run then ends early, and the result and the table say that
                        throughput and latency come from a shorter window. Raise <Bold>Max instances</Bold>, shorten the duration or
                        set a <Bold>Rate</Bold>.
                    </Paragraph>
                    <Paragraph>
                        <Bold>Associations</Bold> is how many associations are open at the same time, each with one C-STORE in
                        flight: this is what loads the PACS. <Bold>Per association</Bold> is how many images an association
                        sends before it is released and a new one is opened in its place. It never changes how many are open at
                        once, only how often they are replaced, and tests association setup under load. With 4 associations and
                        1000 images, 0 opens 4 associations in all, 50 about 20, and 1 opens one per image.
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="160"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Load</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Sends on <Bold>Associations</Bold> associations at once, for a duration or a count, optionally at a fixed <Bold>Rate</Bold> over all of them. PASS when everything was stored. FAIL when the PACS refused images, left one without a response, ended an association or rejected one.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Ramp</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Runs the <Bold>Steps</Bold> one after the other, for example 1, 2, 4 and 8 associations, and finds the step where more associations stop helping: throughput rises less than 10 % over the best step before, p95 latency is more than twice that of step 1, or errors appear. The summary marks that step. PASS when the ramp reached an answer. FAIL when errors came before saturation.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Soak</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Steady load at a <Bold>Rate</Bold> for a long <Bold>Duration</Bold>, such as 30m or 8h. Every <Bold>Snapshot</Bold> seconds a row is written to a file at once, so a crash keeps what was measured. FAIL, as a finding, when p95 latency rises by more than 50 % or throughput falls by more than 20 % over the soak, or errors appear.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">What is measured</Paragraph>
                    <Paragraph>
                        Each association has one C-STORE outstanding at a time. <Bold>Latency</Bold> is the time from the first
                        byte of the C-STORE request until the whole response has arrived, so it includes sending the image.
                        <Bold>Setup</Bold> is from opening the connection until the association is accepted.
                        <Bold>Stored/s</Bold> and <Bold>MB/s</Bold> count what was stored with Success or Warning, after the
                        <Bold>Warm-up</Bold>. Errors are counted from the start, warm-up included. The images are generated and
                        encoded before the run, and each send gets new UIDs under the UID root in Test settings, so generating
                        them is not part of what is measured.
                    </Paragraph>
                    <Paragraph>
                        The chart shows stored and failed per second and latency p50 and p95, at most once a second. The
                        warm-up is the shaded band marked <Italic>warm-up</Italic>, and ramp steps are marked. The last second
                        of a run is usually cut short, so it is left out of the lines. Hover over the chart to see one second. The progress bar at the bottom of the window follows the run once a second: time against the duration, all steps of a ramp, or images against the count.
                        The table below it fills in when the run is over. A row in red had images that were not stored or
                        associations that failed, the same red as a FAIL on the Tests tab, and its <Bold>Note</Bold> starts with
                        how many and their raw status codes. A row in yellow is a ramp step or a soak window to look at.
                        The rest of the Note says how the run stopped, which is information and never a fault.
                    </Paragraph>
                    <Paragraph>
                        <Bold>p50, p95 and p99</Bold> are percentiles of the latency. p50 is the median: half the C-STOREs
                        took less than that and half took longer. p95 means that 95 % took less and the slowest 5 % took
                        longer, which shows how bad the slow ones get without one odd image deciding it. p99 is the slowest 1 %,
                        and <Bold>Max</Bold> the slowest single one.
                    </Paragraph>
                    <Paragraph> <Bold>Time-to-available</Bold> asks with C-FIND, on an association of its own,
                        for 1 in the given number of stored images until each is found, and says how long that took.
                    </Paragraph>
                    <Paragraph>
                        <Bold>Mix</Bold> chooses what is sent: small CT images, many small CR and US images, few large
                        multi-frame images, uncompressed or in JPEG Lossless. The last one, <Bold>custom</Bold>, sends the
                        object described on the <Bold>Exam</Bold> tab: its Modality, Rows x Columns, Bits stored, Frames per
                        image, Transfer syntax and private payload. Exam type, Series, Images per series and the Identifiers
                        tab are not used, since a load run makes its own studies and patient. The text beside the list says
                        what will be sent, and so do the plan, the result file and the report. A load run keeps its objects
                        in memory, so one object of the custom mix can be at most 1 GB, and a long cine loop takes minutes
                        to prepare before the run starts. Lower <Bold>Max instances</Bold> before a run with a large
                        object. <Bold>Max PDU</Bold> is the PDU length DCST4
                        announces and sends with. The results go to the results folder set under <Bold>File &gt; Settings</Bold>, with a file of
                        one row per second next to them if <Bold>Performance series (CSV)</Bold> is ticked there. <Bold>Cancel</Bold> stops the run within a few seconds and releases the
                        associations.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Reports and comparison">
                    <Paragraph Style="{StaticResource H1}">Reports and comparison</Paragraph>
                    <Paragraph>
                        Every run on the Tests and Performance tabs writes a report beside its result files, with the same
                        name and the ending <Italic>.html</Italic>. <Bold>Open report</Bold> on each tab opens the report of
                        the last run in your browser. The report is one file that is complete in itself: it loads nothing
                        from the network and holds no script, so it can be mailed or archived as it is. Its last line
                        links to the DCST4 project on GitHub, which is the only address in it that leaves the page.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">What the report holds</Paragraph>
                    <List>
                        <ListItem><Paragraph>The destination, the DCST4 version and the number of results of each class, and every test with its raw status and explanation.</Paragraph></ListItem>
                        <ListItem><Paragraph>The <Bold>vendor fingerprint</Bold>: the Implementation Class UID and Version Name of the system, and how it behaves. See below.</Paragraph></ListItem>
                        <ListItem><Paragraph>The capability matrix, the chain per object type, and what the integrity check found.</Paragraph></ListItem>
                        <ListItem><Paragraph>The limits that were found, and how Storage Commitment went.</Paragraph></ListItem>
                        <ListItem><Paragraph>For a Performance test, charts of throughput and latency and the tables of the run, the ramp steps or the soak windows. The chart of a Load run is drawn from its series file, so keep that file beside the result file.</Paragraph></ListItem>
                        <ListItem><Paragraph>The protocol timeline of every test that ended in FAIL, TIMEOUT or TOOL_ERROR.</Paragraph></ListItem>
                    </List>
                    <Paragraph Style="{StaticResource Note}">
                        Text that came from the system under test, such as an Error Comment or a version name, is always shown
                        as text. Markup in it is never run or fetched.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Vendor fingerprint</Paragraph>
                    <Paragraph>
                        The fingerprint describes the system as a product, which is useful when two vendors or two versions
                        are compared: what it accepts, whether an unknown AE title is refused, whether it returns objects in
                        the transfer syntax they were sent in, which attributes it changes or adds, how it takes a duplicate,
                        where its Storage Commitment report comes, how many associations it holds and how it refuses the next
                        one, and what it does after a broken transfer. Each row names the test it came from. A row says
                        <Italic>not tested</Italic> when no test of the run could tell, so run the tests you want it to cover.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">Compare runs</Paragraph>
                    <Paragraph>
                        <Bold>Compare runs...</Bold> on the Tests tab opens a list of saved runs. <Bold>Add...</Bold> chooses
                        their result files, <Italic>DCST4-run-&lt;time&gt;.json</Italic>, from the results folder. The run at the
                        top is the baseline, and <Bold>Move up</Bold> and <Bold>Move down</Bold> change the order.
                        <Bold>Compare</Bold> compares each of the others with the baseline, writes
                        <Italic>DCST4-compare-&lt;time&gt;.html</Italic> to the results folder and opens it.
                        <Bold>Open report</Bold> in the same window opens the report of the selected run, also one from an
                        earlier version of DCST4.
                    </Paragraph>
                    <Paragraph>A <Bold>regression</Bold> is one of these:</Paragraph>
                    <List>
                        <ListItem><Paragraph>A test, or a step of the chain, that did worse: from PASS or EXPECTED_FAILURE to NOT_SUPPORTED, or from any of those to FAIL or TIMEOUT.</Paragraph></ListItem>
                        <ListItem><Paragraph>A combination of SOP class and transfer syntax that was accepted and no longer is.</Paragraph></ListItem>
                        <ListItem><Paragraph>In a Performance test: throughput lower, or p95 latency or time-to-available higher, by more than the <Bold>Threshold</Bold>, 10 % by default. A latency must also have risen by at least 1 ms. Or an error rate that rose by more than 1 percentage point.</Paragraph></ListItem>
                    </List>
                    <Paragraph>
                        Improvements and other differences are listed apart, and so is what cannot be compared: a test that
                        only one of the runs has, one that was cancelled or ended in TOOL_ERROR, and a Performance test that
                        was run with other settings. Those are never counted against the system. Times, UIDs, the seed and the
                        wording of explanations are never compared, so two runs of the same tests against the same system
                        show no differences. The fingerprints of all the runs are shown side by side at the end.
                    </Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        Throughput and latency vary from run to run, also against the same system. Compare several runs before
                        you trust a difference, and look at the charts of each run.
                    </Paragraph>
                    <Paragraph Style="{StaticResource H2}">On the command line</Paragraph>
                    <Paragraph>
                        <Italic>DCST4.Cli.exe report --run &lt;file&gt;</Italic> writes the report of a saved run, and
                        <Italic>DCST4.Cli.exe compare --runs &lt;a&gt; &lt;b&gt; --threshold 10</Italic> compares runs. The exit
                        code of <Italic>compare</Italic> is 0 with no regression, 1 with at least one and 2 when a file cannot
                        be read, so it can stop a script.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Command line and datasets">
                    <Paragraph Style="{StaticResource H1}">Command line and test datasets</Paragraph>
                    <Paragraph>DCST4.Cli.exe is in the program's folder.</Paragraph>
                    <Paragraph Style="{StaticResource H2}">Running tests</Paragraph>
                    <Paragraph>
                        Click <Bold>Save profile as JSON</Bold> on the <Bold>Tests</Bold> tab to write the destination to a
                        file, and then run:
                    </Paragraph>
                    <Paragraph FontFamily="Consolas">DCST4.Cli.exe run --profile target.json --tests c-echo --out C:\Temp\results</Paragraph>
                    <Paragraph>
                        <Italic>all</Italic> and the <Italic>Integrity</Italic> category include the tests that store objects
                        on the destination, so check the profile first. Those tests also take these options:
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="150"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>--seed</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Fixes the generated data. The same seed repeats the same UIDs, which on a real system are duplicates.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--matrix</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>A saved capability matrix to choose the transfer syntax from.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--transfer-syntax</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Send everything in this syntax where the object type allows it.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--index-wait</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>How long an object may take to appear in a query, in seconds. Default 30.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--commit-linger</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds to keep the Storage Commitment association open for the report. 0 releases at once. Default 10.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--commit-wait</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds the Storage Commitment report may take. Default 60.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--commit-grace</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds to go on listening for a late report. Default 30.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--max-associations</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Where the test of simultaneous associations stops if none is refused. Default 10.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--idle-wait</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds to wait for an idle association to be ended. Default 120.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--artim-wait</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds to wait on a connection with no association request. Default 60.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>--fault-settle</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Seconds a fault test looks for the image after a broken transfer. Default 5.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph>
                        <Italic>all</Italic> and the <Italic>Limits</Italic> category also include the tests that strain the
                        destination and break transfers on purpose. See the topic Limits and faults.
                    </Paragraph>
                    <Paragraph>
                        <Italic>all</Italic> leaves out the Performance tests, <Italic>load-throughput</Italic>,
                        <Italic>load-ramp</Italic> and <Italic>load-soak</Italic>. Name them or use
                        <Italic>--tests Performance</Italic>. Their settings are the <Italic>--load-</Italic>,
                        <Italic>--ramp-</Italic>, <Italic>--soak-</Italic> and <Italic>--tta-</Italic> options in
                        <Italic>DCST4.Cli.exe --help</Italic>, and the plan is printed before anything is sent.
                        <Italic>list-mixes</Italic> shows what can be sent.
                    </Paragraph>
                    <Paragraph>
                        What was sent and retrieved is kept under the <Italic>--out</Italic> folder in
                        <Italic>work-&lt;time&gt;</Italic>.
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="90"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Exit code 0</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>No FAIL or TOOL_ERROR.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>1</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>At least one FAIL or TOOL_ERROR.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>2</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Bad arguments, an unusable profile or results that could not be saved.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>130</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Cancelled with Ctrl+C.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Test datasets</Paragraph>
                    <Paragraph>DCST4.Cli.exe can write reproducible test data:</Paragraph>
                    <Paragraph FontFamily="Consolas">DCST4.Cli.exe generate --dataset ct --out C:\Temp\ct --seed 42</Paragraph>
                    <Paragraph>
                        The same seed gives the same files, with a manifest.json of hashes that can be compared later.
                        <Italic>DCST4.Cli.exe list-datasets</Italic> shows the dataset types, which include multi-frame
                        images, reports, documents and presentation states, and <Italic>list-codecs</Italic> shows which
                        compressions work.
                    </Paragraph>
                    <Paragraph>
                        Patient IDs always come from the list of test personnummer. The name is DCST4^TEST^number by
                        default, which is plainly not a person. For a Swedish name instead, choose it on the
                        <Bold>Identifiers</Bold> tab under <Bold>File &gt; Settings</Bold>, or use
                        <Italic>--patient-naming RegistrySwedishName</Italic> on the command line.
                    </Paragraph>
                    <Paragraph Style="{StaticResource Note}">
                        The same setting gives the Auto patient name of Generate &amp; Send, and of the objects that the tests
                        on the Tests and Performance tabs send. A name typed on the Identifiers tab always wins.
                    </Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Settings">
                    <Paragraph Style="{StaticResource H1}">Settings</Paragraph>
                    <Paragraph>Open <Bold>File &gt; Settings</Bold>. Changes are applied with <Bold>OK</Bold>, and <Bold>Cancel</Bold> discards them.</Paragraph>
                    <Paragraph>
                        <Bold>Reset to defaults...</Bold> puts every setting back to how it was on a first start, also those
                        outside the dialog: the destination fields, the exam, the Tests and Performance tabs and the results
                        folder. The saved destination profiles are kept, and nothing is ticked on the Tests tab. DCST4 asks
                        first, and cannot reset while a test or a send is running.
                    </Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="210"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Network: Connection timeout</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>How long to wait for the TCP connection (default 10 s).</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Network: Association timeout</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>How long to wait for the server to accept or reject the association (default 10 s).</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Network: Response (DIMSE) timeout</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>How long to wait for each response to a C-ECHO or C-STORE request (default 60 s, 0 = no limit).</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Identifiers</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Whether to draw new Auto values after each run, and how an Auto patient name is made, in Generate &amp; Send and in the tests: DCST4^TEST^number (the default) or a Swedish name.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Burned-in text</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>See <Italic>Burned-in text</Italic>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Additional tags</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>See <Italic>Additional tags</Italic>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Test and Performance Results</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The results folder, which files a run on the Tests and Performance tabs writes (only the HTML report by default), and after how many days old results are deleted. See <Italic>Tests</Italic>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Logging: Log DIMSE Datasets</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Write every request and response dataset to the log.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Logging: Log Data PDUs</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Write the low-level network messages to the log. Produces a lot of output.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Updates</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Show a window at startup when a new version is available. See below.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Version check</Paragraph>
                    <Paragraph>
                        When the program starts it asks GitHub for the latest release, and opens a window if there is a
                        new version, with a link and the release notes. You only see this window when a new version was
                        found: if GitHub cannot be reached, for example on a closed network, the program carries on and
                        says nothing. To turn it off, untick the box on the <Bold>Updates</Bold> tab, and nothing is sent
                        at startup.
                    </Paragraph>
                    <Paragraph>
                        Opening <Bold>Help &gt; About</Bold> also asks GitHub and shows the result in the window, including
                        if the check failed. Nothing is downloaded or installed.
                    </Paragraph>
                    <Paragraph>Settings are stored in <Italic>%LocalAppData%\DCST4\user.config</Italic>.</Paragraph>
                </Section>

                <!-- ===================================================================== -->
                <Section Tag="Troubleshooting and logs">
                    <Paragraph Style="{StaticResource H1}">Troubleshooting and logs</Paragraph>
                    <Table>
                        <Table.Columns>
                            <TableColumn Width="230"/>
                            <TableColumn/>
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow><TableCell><Paragraph><Bold>Could not connect</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>Wrong host or port, the service is not running, or a firewall blocks the port. Try Ping, then check the port.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Association rejected</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The server does not accept the Calling AET, or the called AET is wrong. Check both, and the server's list of allowed senders.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>The SCP did not accept ...</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The server does not take the selected transfer syntax for this SOP class. The message says what it did accept. Choose another syntax, or tick <Bold>Allow fallback to Implicit VR</Bold>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>... (timed out)</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The server did not answer in time. Increase the timeouts under <Bold>File &gt; Settings</Bold> if the server is slow.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Some images got no response</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The association ended before every image was answered. Those images are marked NotSent. Check them in PACS before sending them again.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Run not started</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>A value is missing or not valid. The message names the field.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Remote certificate is invalid</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>The server's TLS certificate is not trusted or does not match the host name. Install the CA certificate, or for testing tick <Italic>Accept self-signed or invalid server certificates</Italic> under <Bold>TLS options...</Bold>.</Paragraph></TableCell></TableRow>
                            <TableRow><TableCell><Paragraph><Bold>Wrong special characters (Ã¥ instead of å)</Bold></Paragraph></TableCell>
                                <TableCell><Paragraph>See <Italic>Character sets</Italic>.</Paragraph></TableCell></TableRow>
                        </TableRowGroup>
                    </Table>
                    <Paragraph Style="{StaticResource H2}">Logs</Paragraph>
                    <Paragraph>
                        The <Bold>Log</Bold> tab shows this program's messages. The complete log is in
                        <Bold>File &gt; Open log directory</Bold> (<Italic>%LocalAppData%\DCST4\Logs</Italic>). A new file is
                        started each day and the last 7 are kept. The command line program logs to Cli files in the same
                        folder. Attach the log when you report a problem.
                    </Paragraph>
                </Section>

