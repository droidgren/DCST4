<Window x:Class="DCST4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DCST4.Controls"
        xmlns:infra="clr-namespace:DCST4.Infrastructure"
        Height="800" Width="1240" MinHeight="620" MinWidth="980"
        Icon="/DCST4.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <!-- The Transfer syntax list shows each codec family under a heading of its own. -->
        <GroupStyle x:Key="SyntaxFamilyGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF404040" Margin="3,4,0,1"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings" Click="SettingsMenuItem_Click" IsEnabled="{Binding IsIdle}"/>
                <MenuItem Header="_Open log directory" Click="OpenLogDirectoryMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help" InputGestureText="F1" Click="HelpMenuItem_Click"/>
                <MenuItem Header="_Search help..." InputGestureText="Ctrl+F1" Click="SearchHelpMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding LastRunText}" ToolTip="Result of the last run"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
            <StatusBarItem DockPanel.Dock="Right" Width="140">
                <ProgressBar Width="124" Height="12" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Local and Server: same layout as DMWLT4 -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                <GroupBox Header="Local" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid Margin="8,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Calling AET (SCU):" VerticalAlignment="Center"
                               ToolTip="{Binding ToolTip, ElementName=CallingAeBox}"/>
                        <TextBox x:Name="CallingAeBox" Grid.Column="1" Text="{Binding CallingAET, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip="The AE title DCST4 calls from when it opens an association as SCU: C-STORE, C-ECHO, C-FIND and C-MOVE requests. The destination may only accept AE titles it knows, so it often has to be set up there.&#x0a;&#x0a;Default: DCST4."/>

                        <Label Grid.Row="1" Content="Listen AET (SCP):" VerticalAlignment="Center"
                               ToolTip="{Binding ToolTip, ElementName=LocalScpAeBox}"/>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" IsEnabled="{Binding IsIdle}">
                            <TextBox x:Name="LocalScpPortBox" DockPanel.Dock="Right" Text="{Binding LocalScpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center"
                                     ToolTip="Where this computer listens while a C-MOVE or Storage Commitment test runs. Windows Defender Firewall must allow incoming TCP on it.&#x0a;&#x0a;Default: 11113."/>
                            <TextBlock DockPanel.Dock="Right" Text="Port:" VerticalAlignment="Center" Margin="10,0,4,0"
                                       ToolTip="{Binding ToolTip, ElementName=LocalScpPortBox}"/>
                            <TextBox x:Name="LocalScpAeBox" Text="{Binding LocalScpAe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                     ToolTip="The AE title of this computer as SCP: the PACS connects back to it with C-MOVE objects and Storage Commitment reports. The PACS must know it, with this computer's address and the port.&#x0a;&#x0a;Default: DCST4."/>
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Server">
                    <Grid Margin="8,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="Profile:" Grid.Row="0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" Margin="0,2,0,2"
                                  ToolTip="Pick a saved destination, or type a name and click Save to store the current connection settings.&#x0a;&#x0a;Default: none."/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Save" Width="50" Margin="6,2,0,2" Command="{Binding SaveProfileCommand}"
                                ToolTip="Save the current connection settings under the typed name"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="Delete" Width="50" Margin="6,2,0,2" Command="{Binding DeleteProfileCommand}"
                                ToolTip="Delete the selected profile"/>

                        <Label Content="AET:" Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ServerAET, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip="The AE title of the destination, the called AE title. Up to 16 characters.&#x0a;&#x0a;Default: ServerAET, a placeholder to replace."/>

                        <Label Content="IP/Hostname:" Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip="The host name or IP address of the destination.&#x0a;&#x0a;Default: ServerHostname, a placeholder to replace."/>

                        <Label Content="Port:" Grid.Row="3" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip="The port the destination listens on for DICOM, often 104 or 11112, or 2762 with TLS.&#x0a;&#x0a;Default: 104."/>

                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,2">
                            <CheckBox Content="Use TLS" IsChecked="{Binding UseTLS, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Connect to the destination over TLS. TLS options sets how its certificate is checked and which client certificate is shown.&#x0a;&#x0a;Default: off."/>
                            <Button Content="TLS options..." Margin="12,0,0,0" Padding="8,0" Click="TlsOptionsButton_Click"
                                    IsEnabled="{Binding UseTLS}"
                                    ToolTip="Server certificate validation and client certificate"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <Button Content="Ping" Width="100" Command="{Binding PingCommand}" Margin="0,0,8,0"/>
                            <Button Content="Dicom Echo" Width="100" Command="{Binding DicomEchoCommand}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </DockPanel>

            <!-- What to generate, and what to do with it -->
            <DockPanel Grid.Row="0" Grid.Column="1">
                <GroupBox Header="Output" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid Margin="8,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Send to server" IsChecked="{Binding SendImages, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}" ToolTip="Send the generated exam to the destination with C-STORE.&#x0a;&#x0a;Default: on."/>
                        <CheckBox Grid.Column="1" Content="Save to disk:" IsChecked="{Binding SaveImages, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,6,0" IsEnabled="{Binding IsIdle}" ToolTip="Also write the generated exam to the folder beside it, as a DICOM File-set with a DICOMDIR.&#x0a;&#x0a;Default: off."/>
                        <TextBox Grid.Column="2" Text="{Binding SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" IsEnabled="{Binding SaveImages}" ToolTip="The folder Save to disk writes the File-set to.&#x0a;&#x0a;Default: none."/>
                        <Button Grid.Column="3" Content="..." Width="26" Margin="4,0,0,0" Click="BrowseFolderButton_Click" IsEnabled="{Binding SaveImages}" ToolTip="Select the folder"/>
                        <Button Grid.Column="4" Width="120" Height="28" Margin="12,0,8,0" Command="{Binding RunCommand}" FontWeight="SemiBold">
                            <TextBlock Text="{Binding RunButtonText}"/>
                        </Button>
                        <Button Grid.Column="5" Content="Cancel" Width="80" Height="28" Command="{Binding CancelCommand}"/>
                    </Grid>
                </GroupBox>

                <TabControl IsEnabled="{Binding IsIdle}" MinHeight="280">
                    <TabItem Header="Exam">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Label Content="Modality:"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Modalities}" SelectedItem="{Binding SelectedModality, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2" ToolTip="The kind of images to generate. Changing it sets the matrix, bits stored and exam type to that modality's defaults.&#x0a;&#x0a;Default: CT."/>
                            <Label Grid.Column="3" Content="Exam type:"/>
                            <ComboBox Grid.Column="4" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2"
                                      ToolTip="Sets the descriptions, body part and modality-specific tags.&#x0a;&#x0a;Default: the first exam type of the modality, Head for CT."/>

                            <Label Grid.Row="1" Content="Series:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SeriesCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2" ToolTip="How many series the exam has, each with the number of images below.&#x0a;&#x0a;Default: 1."/>
                            <Label Grid.Row="1" Grid.Column="3" Content="Images per series:"/>
                            <DockPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalImagesText}" Foreground="#FF505050" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding ImagesPerSeries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2"
                                         ToolTip="1 gives a single test image.&#x0a;&#x0a;Default: the exam type's own number."/>
                            </DockPanel>

                            <Label Grid.Row="2" Content="Rows x Columns:"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Rows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="64 to 4096.&#x0a;&#x0a;Default: the modality's own, 512 for most."/>
                                <TextBlock Grid.Column="1" Text=" x " VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="64 to 4096.&#x0a;&#x0a;Default: the modality's own, 512 for most."/>
                            </Grid>
                            <Label Grid.Row="2" Grid.Column="3" Content="Bits stored:"/>
                            <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitsStored, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2"
                                      ToolTip="The list shows what the selected modality's IOD allows.&#x0a;&#x0a;Default: the modality's own, 16 for CT."/>

                            <Label Grid.Row="3" Content="Character set:"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CharacterSets}" SelectedItem="{Binding CharacterSet, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2"
                                      ToolTip="Specific Character Set (0008,0005): ISO_IR 100 is Latin-1, ISO_IR 192 is UTF-8. Empty value sends the tag with zero length, which means Basic ASCII, so Auto names lose their å, ä and ö.&#x0a;&#x0a;Default: ISO_IR 100."/>
                            <Label Grid.Row="3" Grid.Column="3" Content="Transfer syntax:"/>
                            <ComboBox Grid.Row="3" Grid.Column="4" ItemsSource="{Binding TransferSyntaxView}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding SelectedTransferSyntax, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2"
                                      ToolTip="The transfer syntax the images are sent and saved in, by codec family. Lossy syntaxes say so in their name. JPEG XL is written lossless by DCST4's own encoder, in both of its syntaxes. H.264 uses the encoder of Windows and is for US Multi-frame only, since the XA and RF images must be MONOCHROME2. JPEG XL and H.264 cannot fall back to Implicit VR, since DCST4 cannot decode them.&#x0a;&#x0a;Default: Explicit VR Little Endian.">
                                <ComboBox.GroupStyle>
                                    <StaticResource ResourceKey="SyntaxFamilyGroupStyle"/>
                                </ComboBox.GroupStyle>
                            </ComboBox>

                            <Label Grid.Row="4" Content="Estimated size:"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EstimatedSizeText}" Foreground="#FF505050" VerticalAlignment="Center"
                                       ToolTip="The whole exam as sent or saved, not counting a DICOMDIR. For JPEG Lossless, one sample image is compressed and the result multiplied by the number of images."/>

                            <CheckBox Grid.Row="4" Grid.Column="4" Content="Allow fallback to Implicit VR" Margin="0,4,0,0"
                                      IsChecked="{Binding AllowFallback, Mode=TwoWay}" IsEnabled="{Binding FallbackIsRelevant}"
                                      ToolTip="Off: the run stops with an error if the server does not accept the selected syntax. On: send as Implicit VR instead, as a real modality would, and flag it.&#x0a;&#x0a;Default: off."/>

                            <Label Grid.Row="5" Content="Object:"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding ImageObjects}" SelectedItem="{Binding SelectedImageObject, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2"
                                      ToolTip="Which image of the modality to generate, named after its IOD. US, CT, MR and MG also have a multi-frame image: Ultrasound Multi-frame Image, Enhanced CT Image, Enhanced MR Image and Breast Tomosynthesis Image.&#x0a;&#x0a;Default: the modality's ordinary image."/>
                            <Label Grid.Row="5" Grid.Column="3" Content="Frames per image:"/>
                            <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding FramesPerImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsMultiFrame}" VerticalAlignment="Center" Margin="0,2"
                                     ToolTip="How many frames each image has, 1 to 10000. Only for a multi-frame object: Ultrasound Multi-frame, Enhanced CT, Enhanced MR and Breast Tomosynthesis. An ultrasound cine loop has 30 frames per second.&#x0a;&#x0a;Without compression an image holds less than 4 GB of pixels. A long cine loop needs JPEG Baseline or JPEG Lossless, and its frames are then encoded before the image is sent.&#x0a;&#x0a;Default: 30 for a cine loop, 8 for the others." ToolTipService.ShowOnDisabled="True"/>
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="5,6,0,0">
                                <CheckBox Content="Add private payload of" IsChecked="{Binding AddPrivatePayload, Mode=TwoWay}" VerticalAlignment="Center"
                                          ToolTip="Adds a private sequence with one large binary value to every image, as some ultrasound systems do with their raw data. The value is random bytes under the private creator DCST4 TEST, in (0099,1020). Use it to find out whether a PACS takes images with large private data.&#x0a;&#x0a;It is off every time DCST4 starts. The size is remembered.&#x0a;&#x0a;Default: off."/>
                                <TextBox Text="{Binding PrivatePayloadMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AddPrivatePayload}" Width="50" Margin="6,0,4,0" VerticalAlignment="Center"
                                         ToolTip="The size of the private payload in megabytes, for each image: 1 to 2000.&#x0a;&#x0a;Default: 100." ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock Text="MB per image" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Identifiers">
                        <DockPanel Margin="4">
                            <DockPanel DockPanel.Dock="Bottom" Margin="4,4,4,0">
                                <Button DockPanel.Dock="Right" Content="New values" Width="100" Command="{Binding NewValuesCommand}"
                                        ToolTip="Draw a new patient and new identifiers for the Auto fields"/>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Random patient age:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding MinAge, Mode=TwoWay}" Width="36" Margin="6,0,4,0" VerticalAlignment="Center" ToolTip="The youngest age, in years, of a random patient from the test personnummer list.&#x0a;&#x0a;Default: 0."/>
                                    <TextBlock Text="to" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding MaxAge, Mode=TwoWay}" Width="36" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="The oldest age, in years, of a random patient from the test personnummer list.&#x0a;&#x0a;Default: 100."/>
                                </StackPanel>
                                <TextBlock Text="{Binding IdentityMessage}" Foreground="#FFB03000" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"/>
                            </DockPanel>
                            <!-- The row above this tab sizes to its content, so without MaxHeight added tags would never scroll and would squeeze Results instead. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                            <ItemsControl ItemsSource="{Binding IdentityFields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,1" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="104" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox DockPanel.Dock="Left" Content="Auto" IsChecked="{Binding IsAuto, Mode=TwoWay}" IsEnabled="{Binding ManualAllowed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                        <Setter Property="Background" Value="#FFF0F0F0"/>
                                                        <Setter Property="Foreground" Value="#FF505050"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                                <Setter Property="IsReadOnly" Value="False"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent"/>

            <!-- One row per image, and the live log -->
            <TabControl Grid.Row="2" Grid.ColumnSpan="2">
                <TabItem Header="Results">
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                              EnableRowVirtualization="True" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" Background="White">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Warning">
                                        <Setter Property="Background" Value="#FFFFF4C2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failure">
                                        <Setter Property="Background" Value="#FFFAD4D0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="SaveFailed">
                                        <Setter Property="Background" Value="#FFFAD4D0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="NotSent">
                                        <Setter Property="Background" Value="#FFE6E6E6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Cancel">
                                        <Setter Property="Background" Value="#FFE6E6E6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Series" Binding="{Binding SeriesNumber}" Width="50"/>
                            <DataGridTextColumn Header="Instance" Binding="{Binding InstanceNumber}" Width="60"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCodeText}" Width="60"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="240"/>
                            <DataGridTextColumn Header="Error Comment" Binding="{Binding ErrorComment}" Width="160"/>
                            <DataGridTextColumn Header="Offending" Binding="{Binding OffendingElement}" Width="90"/>
                            <DataGridTextColumn Header="Syntax used" Binding="{Binding AcceptedTransferSyntax}" Width="150"/>
                            <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="50"/>
                            <DataGridTextColumn Header="SOP Instance UID" Binding="{Binding SopInstanceUid}" Width="280"/>
                            <DataGridTextColumn Header="Saved to" Binding="{Binding SavedPath}" Width="200"/>
                            <DataGridTextColumn Header="Save error" Binding="{Binding SaveError}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Tests">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,4">
                            <Button DockPanel.Dock="Left" Content="Run tests" Width="80" Command="{Binding RunTestsCommand}" FontWeight="SemiBold"
                                    ToolTip="Run the ticked tests against the destination above"/>
                            <Button DockPanel.Dock="Left" Content="Cancel" Width="60" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                                    ToolTip="Stop the run. What was finished is still saved"/>
                            <Button DockPanel.Dock="Left" Content="Test settings..." Width="100" Margin="6,0,0,0" Click="TestSettingsButton_Click" IsEnabled="{Binding IsIdle}"
                                    ToolTip="The UID root, the transfer syntax of the store tests, the Storage Commitment times, the settings of the limit, fault and TLS tests, and the results folder"/>
                            <Button DockPanel.Dock="Left" Content="Save profile as JSON..." Width="140" Margin="6,0,0,0" Click="SaveTargetProfileButton_Click" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Save the destination above, with the local SCP and the UID root, as a file for DCST4.Cli.exe"/>
                            <Button DockPanel.Dock="Right" Content="Open results folder" Width="120" Margin="6,0,0,0" Click="OpenTestResultsFolderButton_Click"
                                    ToolTip="{Binding TestSuite.ResultsFolder}" ToolTipService.ShowOnDisabled="True"/>
                            <Button DockPanel.Dock="Right" Content="Compare runs..." Width="100" Margin="6,0,0,0" Click="CompareRunsButton_Click" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Compare saved runs with each other: what the system no longer supports, tests that now fail, and throughput and latency against a threshold. Also opens the report of any saved run"/>
                            <Button DockPanel.Dock="Right" Content="Open report" Width="85" Command="{Binding OpenReportCommand}"
                                    ToolTip="Open the report of the last run in the browser: one HTML file with the summary, the capability matrix, the chain, the findings and the timelines of failed tests. It is saved beside the result files. If the button is greyed out after a run, both the JSON file and the HTML report are turned off in Test settings" ToolTipService.ShowOnDisabled="True"/>
                            <TextBlock/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#FFABADB3" BorderThickness="1" Background="White" IsEnabled="{Binding IsIdle}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="4,3,4,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TestSuite.SelectionText}" Foreground="#FF505050" VerticalAlignment="Center"/>
                                        <CheckBox Content="Check all" IsChecked="{Binding TestSuite.AllSelected, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                  ToolTip="Tick or clear every test on this tab. Nothing is ticked when DCST4 starts"/>
                                    </DockPanel>
                                    <Separator DockPanel.Dock="Top" Margin="0"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding TestSuite.Groups}" Margin="2,2,2,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,1,0,1">
                                                        <Expander.Header>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                                                      ToolTip="Tick or clear every test in the group">
                                                                <TextBlock>
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                    <Run Text="{Binding CountText, Mode=OneWay}" Foreground="#FF505050"/>
                                                                </TextBlock>
                                                            </CheckBox>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Tests}" Margin="18,1,0,2">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1,0,1" ToolTip="{Binding ToolTipText}">
                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="TestResultsGrid" ItemsSource="{Binding TestSuite.Rows}" SelectedItem="{Binding TestSuite.SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0" SelectionMode="Single"
                                          ClipboardCopyMode="IncludeHeader" Background="White">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="NOT_SUPPORTED">
                                                    <Setter Property="Background" Value="#FFFFF4C2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#FFFAD4D0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="TOOL_ERROR">
                                                    <Setter Property="Background" Value="#FFFAD4D0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="TIMEOUT">
                                                    <Setter Property="Background" Value="#FFE6E6E6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="INDETERMINATE">
                                                    <Setter Property="Background" Value="#FFE6E6E6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Test" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                                        <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="50"/>
                                        <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent"/>
                                <DockPanel Grid.Row="2">
                                    <TextBox DockPanel.Dock="Top" Text="{Binding TestSuite.SelectedRow.Explanation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="48"
                                             VerticalScrollBarVisibility="Auto" Background="#FFF0F0F0" Margin="0,0,0,2"/>
                                    <DataGrid ItemsSource="{Binding TestSuite.SelectedRow.Timeline}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                                              ClipboardCopyMode="IncludeHeader" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ms" Binding="{Binding OffsetMs}" Width="50"/>
                                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="70"/>
                                            <DataGridTextColumn Header="Protocol step" Binding="{Binding Type}" Width="130"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Chain">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding TestSuite.Chain.Rows}" SelectedItem="{Binding TestSuite.Chain.SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0" SelectionMode="Single"
                                  ClipboardCopyMode="IncludeHeader" Background="White">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Worst}" Value="NOT_SUPPORTED">
                                            <Setter Property="Background" Value="#FFFFF4C2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Worst}" Value="FAIL">
                                            <Setter Property="Background" Value="#FFFAD4D0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Worst}" Value="TOOL_ERROR">
                                            <Setter Property="Background" Value="#FFFAD4D0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Worst}" Value="TIMEOUT">
                                            <Setter Property="Background" Value="#FFE6E6E6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Worst}" Value="INDETERMINATE">
                                            <Setter Property="Background" Value="#FFE6E6E6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Object type" Binding="{Binding ObjectType}" Width="250"/>
                                <DataGridTextColumn Header="Transfer syntax" Binding="{Binding TransferSyntax}" Width="190"/>
                                <DataGridTextColumn Header="Accepted" Binding="{Binding Accepted}" Width="110"/>
                                <DataGridTextColumn Header="Indexed" Binding="{Binding Indexed}" Width="110"/>
                                <DataGridTextColumn Header="Retrievable" Binding="{Binding Retrievable}" Width="110"/>
                                <DataGridTextColumn Header="Intact" Binding="{Binding Intact}" Width="110"/>
                                <DataGridTextColumn Header="Committed" Binding="{Binding Committed}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent"/>
                        <TextBox Grid.Row="2" Text="{Binding TestSuite.Chain.SelectedRow.Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFF0F0F0"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Capabilities">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,4">
                            <Button Content="Save as JSON..." Width="100" Click="SaveCapabilityJson_Click" IsEnabled="{Binding TestSuite.Capabilities.HasMatrix}"/>
                            <Button Content="Save as CSV..." Width="100" Margin="6,0,0,0" Click="SaveCapabilityCsv_Click" IsEnabled="{Binding TestSuite.Capabilities.HasMatrix}"/>
                            <Button Content="Load claimed..." Width="100" Margin="6,0,0,0" Click="LoadClaimedCapabilities_Click" IsEnabled="{Binding TestSuite.Capabilities.HasMatrix}"
                                    ToolTip="Compare with a JSON file of what the vendor's Conformance Statement claims"/>
                            <Button Content="Clear claimed" Width="90" Margin="6,0,0,0" Click="ClearClaimedCapabilities_Click" IsEnabled="{Binding TestSuite.Capabilities.HasClaimed}"/>
                        </StackPanel>
                        <TextBox DockPanel.Dock="Top" Text="{Binding TestSuite.Capabilities.RemoteSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="2,0,2,4"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding TestSuite.Capabilities.LegendText, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FF505050" Margin="2,4,2,2"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="CapabilityGrid" ItemsSource="{Binding TestSuite.Capabilities.Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#FFE0E0E0" VerticalGridLinesBrush="#FFE0E0E0"
                                      SelectionUnit="Cell" CanUserReorderColumns="False" CanUserSortColumns="False" Background="White"/>
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding TestSuite.Capabilities.ComparisonSummary}" FontWeight="SemiBold" Margin="2,0,2,2"/>
                                <DataGrid ItemsSource="{Binding TestSuite.Capabilities.Differences}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                                          ClipboardCopyMode="IncludeHeader" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Difference" Binding="{Binding Kind}" Width="170"/>
                                        <DataGridTextColumn Header="SOP class" Binding="{Binding SopClass}" Width="300"/>
                                        <DataGridTextColumn Header="Transfer syntax" Binding="{Binding TransferSyntax}" Width="260"/>
                                        <DataGridTextColumn Header="What the SCP did" Binding="{Binding Actual}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Performance">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,4">
                            <Button Content="Run" Width="80" Command="{Binding RunPerformanceCommand}" FontWeight="SemiBold"
                                    ToolTip="Shows how many new objects the test will store on the destination above, and starts it when you say yes"/>
                            <Button Content="Cancel" Width="60" Margin="6,0,0,0" Command="{Binding CancelCommand}"/>
                            <Button Content="Open report" Width="85" Margin="6,0,0,0" Command="{Binding OpenPerformanceReportCommand}"
                                    ToolTip="Open the report of the last run on this tab in the browser: one HTML file with the settings, the charts and the tables. It is saved beside the result files. To compare runs, use Compare runs... on the Tests tab" ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="Performance settings..." Width="140" Margin="6,0,0,0" Click="PerformanceSettingsButton_Click" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Associations, how often a new association is opened, the PDU length, the duration, count and rate of each test, the ramp steps, the soak's snapshots, Max instances, the warm-up and time-to-available"/>
                            <TextBlock Text="Test:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <ComboBox ItemsSource="{Binding Performance.Modes}" SelectedItem="{Binding Performance.SelectedMode, Mode=TwoWay}" Width="300" IsEnabled="{Binding IsIdle}" ToolTip="Which performance test to run: steady load, a ramp of more and more associations, or a long soak.&#x0a;&#x0a;Default: Load: throughput and latency."/>
                            <TextBlock Text="Mix:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <ComboBox ItemsSource="{Binding Performance.Mixes}" SelectedItem="{Binding Performance.SelectedMix, Mode=TwoWay}" Width="130" IsEnabled="{Binding IsIdle}"
                                      ToolTip="The objects the test sends: their types, sizes and transfer syntax. The text beside the list describes the selected mix.&#x0a;&#x0a;custom sends the object described on the Exam tab: its Modality, Rows x Columns, Bits stored, Frames per image, Transfer syntax and private payload. Exam type, Series, Images per series and the Identifiers tab are not used. One object can be at most 1 GB, since a load run keeps its objects in memory.&#x0a;&#x0a;Default: ct." DisplayMemberPath="Id"/>
                            <TextBlock Text="{Binding Performance.MixDescription}" Foreground="#FF505050" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Performance.PlanText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="2,0,2,6"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" MinHeight="160"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#FFE1E0D9" BorderThickness="1">
                                <controls:LoadChart Series="{Binding Performance.Series}" Version="{Binding Performance.SeriesVersion}"/>
                            </Border>
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent"/>
                            <DockPanel Grid.Row="2">
                                <TextBox DockPanel.Dock="Top" Text="{Binding Performance.Verdict, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,2,0,2"/>
                                <TextBox DockPanel.Dock="Bottom" Text="{Binding Performance.Files, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FF505050" Margin="0,2,0,0"/>
                                <TextBox DockPanel.Dock="Bottom" Text="{Binding Performance.Availability, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,2,0,0"/>
                                <DataGrid ItemsSource="{Binding Performance.Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                                          ClipboardCopyMode="IncludeHeader" Background="White">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Marked}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Background" Value="#FFFFF4C2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Problem}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Background" Value="#FFFAD4D0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Measured" Binding="{Binding Label}" Width="150"/>
                                        <DataGridTextColumn Header="Associations" Binding="{Binding Associations}" Width="80"/>
                                        <DataGridTextColumn Header="Stored" Binding="{Binding Stored}" Width="60"/>
                                        <DataGridTextColumn Header="Stored/s" Binding="{Binding StoredPerSecond}" Width="65"/>
                                        <DataGridTextColumn Header="MB/s" Binding="{Binding MegabytesPerSecond}" Width="55"/>
                                        <DataGridTextColumn Header="p50 ms" Binding="{Binding LatencyP50}" Width="60"/>
                                        <DataGridTextColumn Header="p95 ms" Binding="{Binding LatencyP95}" Width="60"/>
                                        <DataGridTextColumn Header="p99 ms" Binding="{Binding LatencyP99}" Width="60"/>
                                        <DataGridTextColumn Header="Max ms" Binding="{Binding LatencyMax}" Width="60"/>
                                        <DataGridTextColumn Header="Setup p50 ms" Binding="{Binding Setup}" Width="85"/>
                                        <DataGridTextColumn Header="Not stored" Binding="{Binding NotStored}" Width="70"/>
                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Log">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                            <Button Content="Clear" Width="60" Command="{Binding ClearLogCommand}"/>
                            <Button Content="Copy" Width="60" Margin="6,0,0,0" Click="CopyLogButton_Click" ToolTip="Copy the selected lines, or all if none is selected"/>
                            <TextBlock Text="The full log, including fo-dicom's own detail, is in File > Open log directory." Foreground="#FF505050" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" SelectionMode="Extended"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
