<Window x:Class="DCST4.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image preview"
        Width="720" Height="800" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
            <Button DockPanel.Dock="Right" Content="Close" Width="75" Height="23" VerticalAlignment="Bottom" Margin="12,0,0,0" Click="Close_Click" IsCancel="True"/>
            <StackPanel>
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="#FFB03000" Margin="0,4,0,0" Visibility="Collapsed"/>
                <TextBlock Text="The first frame of the first image, as it would be sent. Nothing has been sent or saved." Foreground="#FF505050" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <!-- Shown at its own size, or smaller to fit, so that compression artefacts are not hidden by scaling up. -->
        <Border Background="Black">
            <Image x:Name="PreviewImageControl" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
    </DockPanel>
</Window>
