<Window x:Class="DCST4.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,10">
            <TabItem Header="Network">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Connection timeout:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ConnectionTimeoutBox" VerticalAlignment="Center" Margin="0,2" ToolTip="Seconds to wait for the TCP connection to the destination before giving up.&#x0a;&#x0a;Default: 10 s."/>
                    <Label Grid.Row="0" Grid.Column="2" Content="seconds (1-3600)"/>

                    <Label Grid.Row="1" Content="Association timeout:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AssociationTimeoutBox" VerticalAlignment="Center" Margin="0,2"
                             ToolTip="Time to wait for the server to accept or reject the association.&#x0a;&#x0a;Default: 10 s."/>
                    <Label Grid.Row="1" Grid.Column="2" Content="seconds (1-3600)"/>

                    <Label Grid.Row="2" Content="Response (DIMSE) timeout:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ResponseTimeoutBox" VerticalAlignment="Center" Margin="0,2"
                             ToolTip="Time to wait for each response to a C-ECHO or C-STORE request.&#x0a;&#x0a;Default: 60 s."/>
                    <Label Grid.Row="2" Grid.Column="2" Content="seconds (0 = no limit)"/>
                </Grid>
            </TabItem>

            <TabItem Header="Identifiers">
                <StackPanel Margin="5">
                    <CheckBox x:Name="NewValuesAfterRun" Content="Draw new Auto values after each run" ToolTip="Draw a new patient, accession number and UIDs after every Generate &amp; Send. Off keeps them, so the next run adds a series to the same study.&#x0a;&#x0a;Default: off."/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="When off, Auto values stay until you click New values or restart the program, so the exam is easy to find in PACS. Another run with the same values adds a new series to the same study."/>

                    <Label Margin="0,14,0,0" Padding="0,0,0,4" Content="Patient name in generated objects:"/>
                    <ComboBox x:Name="TestPatientNaming" SelectedValuePath="Tag" HorizontalAlignment="Left" MinWidth="280" ToolTip="How an Auto patient name is made, in Generate &amp; Send and in the objects the tests on the Tests and Performance tabs send. The Auto Referring Physician Name follows it: DCST4^REFERRING^number with the marked name, a Swedish name otherwise. A name typed on the Identifiers tab always wins. The Patient ID comes from the test personnummer list either way.&#x0a;&#x0a;Default: Marked test name (DCST4^TEST^number).">
                        <ComboBoxItem Tag="MarkedTestName" Content="Marked test name (DCST4^TEST^number), the default"/>
                        <ComboBoxItem Tag="RegistrySwedishName" Content="Swedish name"/>
                    </ComboBox>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="For the Auto patient name in Generate &amp; Send and in the objects the tests on the Tests and Performance tabs send. The Auto Referring Physician Name follows it, as DCST4^REFERRING^number or a Swedish name. A name typed on the Identifiers tab always wins. The Patient ID comes from the list of test personnummer in both cases."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Burned-in text">
                <StackPanel Margin="5">
                    <CheckBox x:Name="BurnInText" Content="Burn text into the images" ToolTip="Draw a black box with the ticked tags in the upper left corner of every image, to compare with the tags in the viewer.&#x0a;&#x0a;Default: off."/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="Draws the ticked tags in a black box in the upper left corner of each image, so they can be compared with the tags in the viewer. Burned In Annotation (0028,0301) is YES when text is drawn, otherwise NO. The diagonal TEST IMAGE watermark is always there."/>
                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Tags to burn in"/>
                    <ItemsControl x:Name="BurnInTagsList" IsEnabled="{Binding IsChecked, ElementName=BurnInText}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,1" ToolTip="{Binding Number}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <TabItem Header="Additional tags">
                <DockPanel Margin="5">
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Common tags"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#FF505050" Margin="0,2,0,4"
                               Text="Each ticked tag gets a row on the Identifiers tab, with a generated Auto value."/>
                    <ItemsControl x:Name="CommonTagsList" DockPanel.Dock="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,1" ToolTip="{Binding Number}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,10,0,0" Text="Custom tags"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#FF505050" Margin="0,2,0,4"
                               Text="Auto uses the default value. An empty default sends the tag empty. Enter a tag as (0008,1070), 00081070 or a keyword such as OperatorsName, and separate several values with a backslash where the tag allows it."/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Tag:" Target="{Binding ElementName=TagBox}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TagBox" VerticalAlignment="Center" Margin="0,2" TextChanged="TagBox_TextChanged" ToolTip="The tag number, as (gggg,eeee) or ggggeeee, or a keyword such as OperatorsName"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" x:Name="TagNameText" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#FF505050" TextTrimming="CharacterEllipsis"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="VR:" Target="{Binding ElementName=VrBox}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="VrBox" VerticalAlignment="Center" Margin="0,2" ToolTip="The value representation. It is chosen for you when the dictionary gives the tag only one. A private tag needs one chosen here.&#x0a;&#x0a;Default: LO."/>
                        <Label Grid.Row="1" Grid.Column="2" Content="Private creator:" Margin="8,0,0,0" Target="{Binding ElementName=CreatorBox}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="CreatorBox" VerticalAlignment="Center" Margin="0,2" IsEnabled="False"
                                 ToolTip="Required for a private tag, one with an odd group number"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Default:" Target="{Binding ElementName=ValueBox}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ValueBox" VerticalAlignment="Center" Margin="0,2" ToolTip="The default value of the tag, which Auto on the Identifiers tab uses. An empty default sends the tag empty. Separate several values with a backslash where the tag allows it"/>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Add or update" Width="100" Height="23" Margin="0,0,6,0" Click="AddTagButton_Click"/>
                            <Button Content="Remove" Width="80" Height="23" Click="RemoveTagButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="CustomTagsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0" Background="White"
                              SelectionChanged="CustomTagsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Number}" Width="85"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="VR" Binding="{Binding VrCode}" Width="35"/>
                            <DataGridTextColumn Header="Creator" Binding="{Binding PrivateCreator}" Width="80"/>
                            <DataGridTextColumn Header="Default value" Binding="{Binding DefaultValue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Test and Performance Results" x:Name="ResultsTab">
                <StackPanel Margin="5">
                    <DockPanel>
                        <Label DockPanel.Dock="Left" Content="Results folder:" Width="170" ToolTip="{Binding ToolTip, ElementName=ResultsFolderBox}"/>
                        <Button DockPanel.Dock="Right" Content="..." Width="26" Margin="4,2,0,2" Click="BrowseResultsButton_Click" ToolTip="Select the folder"/>
                        <TextBox x:Name="ResultsFolderBox" Text="{Binding ResultsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2"
                                 ToolTip="Where each run on the Tests and Performance tabs writes its result files and the Performance tests their series files, and where the comparisons of runs go. It is made if it is not there.&#x0a;&#x0a;Default: %LocalAppData%\DCST4\TestRuns."/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Label DockPanel.Dock="Left" Content="Each run writes:" Width="170" ToolTip="Which result files a run on the Tests or Performance tab writes. With none ticked a run leaves no files in the results folder. The results are shown in the program either way.&#x0a;&#x0a;Default: HTML report only."/>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="JSON" IsChecked="{Binding WriteJson, Mode=TwoWay}" VerticalAlignment="Center"
                                      ToolTip="The file with full detail, DCST4-run-&lt;time&gt;.json, and the capability matrix as JSON. Compare runs... reads this file, and Open report can make a report from it again. Without it a run cannot be compared later.&#x0a;&#x0a;Default: not ticked."/>
                            <CheckBox Content="CSV" IsChecked="{Binding WriteCsv, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="The file with one row per result, and the capability matrix and the chain as CSV, for a spreadsheet.&#x0a;&#x0a;Default: not ticked."/>
                            <CheckBox Content="HTML report" IsChecked="{Binding WriteHtml, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="The report for reading, one file that is complete in itself, which Open report opens. Without it, Open report makes one from the JSON file when you click it.&#x0a;&#x0a;Default: ticked."/>
                            <CheckBox Content="Performance series (CSV)" IsChecked="{Binding WriteSeries, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="The files a Performance test writes while it runs: DCST4-run-&lt;time&gt;-load-throughput.csv, -load-ramp.csv or -load-soak.csv with one row per second, and for a soak -load-soak-windows.csv with one row per snapshot. They are written as the test goes, so a crash during a long soak keeps what was measured. The HTML report of the run has its per-second charts either way.&#x0a;&#x0a;Default: not ticked."/>
                        </WrapPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Label DockPanel.Dock="Left" Content="Delete results older than:" Width="170" ToolTip="{Binding ToolTip, ElementName=KeepDaysBox}"/>
                        <TextBox DockPanel.Dock="Left" x:Name="KeepDaysBox" Text="{Binding KeepDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" Margin="0,2"
                                 ToolTip="After each run, DCST4 deletes the result files in the results folder that are older than this many days: the files whose names start with DCST4-run- or DCST4-compare- and end in .json, .csv or .html. Nothing else in the folder is touched, and nothing is deleted until a run has been saved. 0 keeps everything.&#x0a;&#x0a;Default: 0."/>
                        <Label Content="days (0 keeps everything)"/>
                    </DockPanel>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="For runs on the Tests and Performance tabs. Compare runs... needs the JSON file of each run it compares. The command line always writes all its files and never deletes anything."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Logging">
                <StackPanel Margin="5">
                    <CheckBox x:Name="LogDimseDatasets" Content="Log DIMSE Datasets" Margin="0,0,0,5" ToolTip="Write every dataset sent and received to the log. The log gets large quickly.&#x0a;&#x0a;Default: off."/>
                    <CheckBox x:Name="LogDataPDUs" Content="Log Data PDUs" ToolTip="Write every data PDU to the log, byte for byte. For tracing a protocol problem only.&#x0a;&#x0a;Default: off."/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="These write fo-dicom's detail to the log file. With images this gets large quickly, so use them for a small run."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Updates">
                <StackPanel Margin="5">
                    <CheckBox x:Name="ShowUpdateWindowAtStartup" Content="Show a window at startup when a new version is available" ToolTip="Ask GitHub at startup whether there is a newer DCST4, and show a window if there is. Off sends nothing at startup.&#x0a;&#x0a;Default: on."/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF505050"
                               Text="The program asks GitHub for the latest release when it starts. When this is off, it does not ask at startup. Help &gt; About still checks when you open it."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Left" Content="Reset to defaults..." Click="ResetButton_Click" Width="130" Height="25"
                    ToolTip="Put all settings back to their defaults, also those outside this window, such as the destination fields and the Tests and Performance tabs. The saved destination profiles are kept. You are asked first"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="OkButton_Click" Width="80" Height="25" Margin="0,0,10,0" IsDefault="True"/>
                <Button Content="Cancel" Width="80" Height="25" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
