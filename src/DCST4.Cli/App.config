<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      Workstation GC with background collection, set on purpose. The load tests allocate little while they measure: the pool
      is encoded in advance and each association reuses one PDU buffer. Server GC would add a heap and a GC thread per
      processor for no gain. During a load test the engine also sets GCSettings.LatencyMode to SustainedLowLatency, which
      keeps blocking full collections out of the measurement, and raises the thread pool's minimum. See the README.
    -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="libs" />
    </assemblyBinding>
  </runtime>
</configuration>
