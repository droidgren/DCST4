<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DCST4.Tests</RootNamespace>
    <AssemblyName>DCST4.Tests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <!-- Program.Main in this project is the entry point, not the referenced app's. -->
    <StartupObject>DCST4.Tests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DCST4.Core\DCST4.Core.csproj" />
    <ProjectReference Include="..\..\src\DCST4.App\DCST4.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
